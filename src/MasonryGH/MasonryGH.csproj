<Project Sdk="Microsoft.NET.Sdk">
  <!-- Grasshopper plugin (.gha). Build on Windows or Mac with Rhino 8 installed. -->
  <PropertyGroup>
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- Labs features (karbandi, muqarnas) are left out of 1.0: build with -p:Labs=true to include them -->
    <DefineConstants Condition="'$(Labs)' == 'true'">$(DefineConstants);HZB_LABS</DefineConstants>
    <Nullable>disable</Nullable>
    <AssemblyName>Hezarbaaf</AssemblyName>
    <RootNamespace>Masonry.GH</RootNamespace>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.*" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" LogicalName="Hezarbaaf.Icons.%(Filename).png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MasonryCore\MasonryCore.csproj" />
  </ItemGroup>
</Project>
