uid" type_code="9">59e0b89a-e487-49f8-bab8-b5bab16be14c</item><item name="Name" type_name="gh_string" type_code="10">Panel</item></items><chunks count="1"><chunk name="Container"><items count="8"><item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item><item name="InstanceGuid" type_name="gh_guid" type_code="9">1ecc5930-a2fa-4d59-927a-357d9a916ee9</item><item name="Name" type_name="gh_string" type_code="10">Panel</item><item name="NickName" type_name="gh_string" type_code="10"></item><item name="Optional" type_name="gh_bool" type_code="1">false</item><item name="ScrollRatio" type_name="gh_double" type_code="6">0</item><item name="SourceCount" type_name="gh_int32" type_code="3">0</item><item name="UserText" type_name="gh_string" type_code="10">SAMANID MAUSOLEUM · آرامگاه سامانیان · Bukhara, Uzbekistan, early 10th century
Builders unknown (Samanid dynasty).

A near-cube of about 10 m whose walls are woven from fired brick in basket patterns that change with the light.
Here: four Hezarbaaf walls on a square, basket motif.
A study of the idea, not a copy. All credit for the design belongs to its authors. Units: metres.</item></items><chunks count="2"><chunk name="Attributes"><items count="5"><item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35"><X>40</X><Y>20</Y><W>700</W><H>140</H></item><item name="MarginLeft" type_name="gh_int32" type_code="3">0</item><item name="MarginRight" type_name="gh_int32" type_code="3">0</item><item name="MarginTop" type_name="gh_int32" type_code="3">0</item><item name="Pivot" type_name="gh_drawing_pointf" type_code="31"><X>390.0</X><Y>90.0</Y></item></items></chunk><chunk name="PanelProperties"><items count="7"><item name="Colour" type_name="gh_drawing_color" type_code="36"><ARGB>255;255;250;90</ARGB></item><item name="DrawIndices" type_name="gh_bool" type_code="1">true</item><item name="DrawPaths" type_name="gh_bool" type_code="1">true</item><item name="Multiline" type_name="gh_bool" type_code="1">true</item><item name="SpecialCodes" type_name="gh_bool" type_code="1">false</item><item name="Stream" type_name="gh_bool" type_code="1">false</item><item name="Wrap" type_name="gh_bool" type_code="1">true</item></items></chunk></chunks></chunk></chunks></chunk><chunk name="Object" index="1"><items count="2"><item name="GUID" type_name="gh_guid" type_code="9">fbac3e32-f100-4292-8692-77240a42fd1a</item><item name="Name" type_name="gh_string" type_code="10">Point</item></items><chunks count="1"><chunk name="Container"><items count="6"><item name="Description" type_name="gh_string" type_code="10">Contains a collection of three-dimensional points</item><item name="InstanceGuid" type_name="gh_guid" type_code="9">b9577017-8732-4fd4-b53f-b217458372c2</item><item name="Name" type_name="gh_string" type_code="10">Point</item><item name="NickName" type_name="gh_string" type_code="10">Pt</item><item name="Optional" type_name="gh_bool" type_code="1">false</item><item name="SourceCount" type_name="gh_int32" type_code="3">0</item></items><chunks count="2"><chunk